{
  "name": "group-theory-visualizer",
  "version": "0.1.0",
  "private": false,
  "description": "Interactive finite-group and symmetry explorer using WASM math, Three.js, and graph visualization.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/group-theory-visualizer.git"
  },
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/clean-pages.mjs && node scripts/build-wasm.mjs && node scripts/write-static-data.mjs",
    "build": "vite build && node scripts/postbuild.mjs",
    "dev": "node scripts/build-wasm.mjs && vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint . && tsc --noEmit && prettier --check .",
    "fmt": "prettier --write .",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@hpcc-js/wasm": "^2.33.5",
    "@tanstack/react-query": "^5.90.12",
    "comlink": "^4.4.2",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.184.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "http-server": "^14.1.1",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^8.0.11",
    "vitest": "^4.0.14",
    "wabt": "^1.0.39"
  }
}
