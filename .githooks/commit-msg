#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
first_line="$(sed -n '1p' "${message_file}")"

if [[ ! "${first_line}" =~ ^(feat|fix|docs|chore|refactor|test|ops|data|build|ci|perf|style)(\([a-zA-Z0-9._-]+\))?!?:\ .+ ]]; then
  printf "Commit message must use Conventional Commits. Got: %s\n" "${first_line}" >&2
  exit 1
fi

